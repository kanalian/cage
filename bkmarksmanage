<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>本地书签目录</title>
<script>try{document.documentElement.dataset.theme=localStorage.getItem('local-bookmarks-theme')||'light'}catch(e){document.documentElement.dataset.theme='light'}</script>
<style>
:root{color-scheme:light;--bg:#f6f8fc;--panel:#fff;--soft:#f8fafc;--line:#e5e7eb;--line2:#dbe3ee;--text:#172033;--sub:#64748b;--muted:#94a3b8;--blue:#2563eb;--blue2:#1d4ed8;--green:#047857;--greenBg:#dcfce7;--amber:#b45309;--amberBg:#fef3c7;--red:#dc2626;--redBg:#fee2e2;--grayBg:#eef2f7;--shadow:0 12px 30px rgba(15,23,42,.07);--r:10px;--r2:14px}
*{box-sizing:border-box}html{font-size:16px}body{margin:0;min-height:100vh;background:radial-gradient(circle at 10% 0,rgba(37,99,235,.12),transparent 390px),var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;font-size:14px;line-height:1.55}button,input,select,textarea{font:inherit}button{cursor:pointer}.wrap{width:min(1180px,calc(100% - 32px));margin:0 auto;padding:24px 0 54px}.top{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:18px}.brand{display:flex;align-items:center;gap:10px;font-size:15px;font-weight:750}.brand i{width:26px;height:26px;border-radius:8px;background:var(--blue);color:white;display:grid;place-items:center;font-style:normal}.top-actions{display:flex;gap:8px;flex-wrap:wrap}.btn{border:1px solid var(--line2);background:#fff;color:var(--text);border-radius:8px;padding:8px 12px;font-size:13px;font-weight:650;display:inline-flex;align-items:center;justify-content:center;gap:6px;box-shadow:0 2px 8px rgba(15,23,42,.04);transition:.15s}.btn:hover:not(:disabled){border-color:#cbd5e1;transform:translateY(-1px)}.btn:disabled{opacity:.55;cursor:not-allowed}.btn.primary{background:var(--blue);border-color:var(--blue);color:#fff}.btn.primary:hover{background:var(--blue2)}.btn.danger{color:var(--red)}.btn.ghost{background:transparent;box-shadow:none}.btn.sm{padding:6px 9px;font-size:12px}.btn.link{border:0;background:transparent;box-shadow:none;color:var(--blue);padding:0}.hero{background:rgba(255,255,255,.88);border:1px solid var(--line);box-shadow:var(--shadow);border-radius:var(--r2);padding:22px;margin-bottom:14px}.hero h1{font-size:30px;line-height:1.15;margin:0 0 6px;letter-spacing:-.03em}.hero p{margin:0;color:var(--sub);font-size:13px;max-width:760px}.nav-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:14px}.nav-tab{border:1px solid var(--line);background:#fff;border-radius:var(--r);padding:13px 14px;text-align:left;box-shadow:0 6px 16px rgba(15,23,42,.04)}.nav-tab b{display:block;font-size:15px;margin-bottom:2px}.nav-tab span{font-size:12px;color:var(--sub)}.nav-tab.active{border-color:#bfdbfe;background:#eff6ff}.nav-tab.active b{color:var(--blue)}.stats{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 14px}.stat{background:#fff;border:1px solid var(--line);border-radius:8px;padding:6px 10px;color:var(--sub);font-size:12px}.stat b{color:var(--text);font-size:13px;margin-right:4px}.panel{background:rgba(255,255,255,.9);border:1px solid var(--line);border-radius:var(--r2);box-shadow:var(--shadow)}.toolbar{padding:14px;margin-bottom:16px}.search{position:relative;margin-bottom:12px}.search span{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#94a3b8;font-size:15px}.search input{padding-left:36px;font-size:14px}.filters{display:grid;grid-template-columns:1.1fr 1fr 1fr 1fr 1.15fr 1fr;gap:9px}.filter-mini{margin-top:11px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;color:var(--sub);font-size:12px}.view-switch{display:flex;gap:6px}.view-switch .btn.active{background:var(--text);color:#fff;border-color:var(--text)}input,select,textarea{width:100%;border:1px solid var(--line2);background:#fff;border-radius:8px;padding:8px 10px;color:var(--text);outline:none;font-size:13px;font-weight:500;line-height:1.35}textarea{min-height:88px;resize:vertical}input::placeholder,textarea::placeholder{color:#a6b0bf;font-size:12px;font-weight:400}select{color:#334155}input:focus,select:focus,textarea:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(37,99,235,.12)}label{display:block;color:#334155;font-weight:700;font-size:12.5px;margin-bottom:12px}label span{display:block;margin-bottom:5px}.grid{display:grid;gap:18px}.section{background:#fff;border:1px solid var(--line);border-radius:var(--r2);padding:18px;box-shadow:0 8px 24px rgba(15,23,42,.05)}.section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:14px;margin-bottom:13px;border-bottom:1px solid #eef2f7;padding-bottom:10px}.section-head h2{margin:0;font-size:18px;line-height:1.2}.section-head small{color:var(--sub);font-size:12px}.links{display:grid;grid-template-columns:repeat(auto-fill,minmax(255px,1fr));gap:12px}.card{position:relative;border:1px solid var(--line);border-radius:10px;background:linear-gradient(#fff,#fbfdff);padding:14px;min-height:120px;display:flex;gap:11px}.card:hover{border-color:#c8d6ea;box-shadow:0 8px 20px rgba(15,23,42,.06)}.fav{width:34px;height:34px;border-radius:9px;background:#eff6ff;color:var(--blue);display:grid;place-items:center;font-weight:800;flex:0 0 auto;overflow:hidden}.fav img{width:20px;height:20px}.card-main{min-width:0;flex:1}.card-title{display:flex;align-items:center;gap:8px;margin:0 0 4px;font-size:15px;font-weight:760;line-height:1.3}.card-title a{color:var(--text);text-decoration:none}.card-title a:hover{color:var(--blue)}.desc{margin:0 0 8px;color:#56657a;font-size:12.5px;line-height:1.45;min-height:18px}.domain{display:block;color:var(--blue);font-size:12px;text-decoration:none;word-break:break-all;margin-bottom:8px}.chips{display:flex;gap:6px;flex-wrap:wrap}.chip{border-radius:6px;background:var(--grayBg);color:#475569;padding:3px 7px;font-size:11px;font-weight:650}.status{border-radius:6px;padding:3px 7px;font-size:11px;font-weight:750;white-space:nowrap}.s-unchecked{background:var(--grayBg);color:#475569}.s-alive{background:var(--greenBg);color:var(--green)}.s-warning{background:var(--amberBg);color:var(--amber)}.s-broken{background:var(--redBg);color:var(--red)}.card-actions{position:absolute;right:10px;bottom:10px;display:flex;gap:6px;opacity:.28;transition:.15s}.card:hover .card-actions{opacity:1}.select-mark{position:absolute;top:9px;right:9px}.select-mark input{width:auto}.list{display:grid;gap:8px}.row{display:grid;grid-template-columns:24px 1.2fr 1.4fr .75fr .8fr auto;gap:10px;align-items:center;background:#fff;border:1px solid var(--line);border-radius:9px;padding:10px 12px}.row b{font-size:13.5px}.row a{font-size:12px;color:var(--blue);text-decoration:none;word-break:break-all}.row .muted{font-size:12px;color:var(--sub)}.batch{padding:12px 14px;margin-bottom:14px;display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center}.batch-left{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.batch select{width:220px}.batch-note{color:var(--sub);font-size:12px}.hidden{display:none!important}.empty{background:#fff;border:1px dashed var(--line2);border-radius:var(--r2);padding:38px 18px;text-align:center;color:var(--sub)}.empty b{display:block;color:var(--text);font-size:17px;margin-bottom:4px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.form-card,.data-card{padding:18px}.wide{grid-column:1/-1}.form-actions,.data-actions{display:flex;flex-wrap:wrap;gap:8px}.suggest-wrap{position:relative}.suggest{position:absolute;z-index:20;left:0;right:0;top:calc(100% + 4px);max-height:210px;overflow:auto;background:#fff;border:1px solid var(--line2);border-radius:8px;box-shadow:0 16px 34px rgba(15,23,42,.12);padding:6px}.suggest button{width:100%;border:0;background:transparent;text-align:left;padding:7px 8px;border-radius:6px;color:#334155;font-size:12.5px}.suggest button:hover{background:#eff6ff;color:var(--blue)}.manage-list{display:grid;gap:8px}.data-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.data-card h3{font-size:15px;margin:0 0 5px}.data-card p{margin:0 0 12px;color:var(--sub);font-size:12.5px}.toast{position:fixed;left:50%;bottom:22px;transform:translateX(-50%);z-index:50;background:#0f172a;color:#fff;border-radius:8px;padding:10px 14px;font-size:13px;box-shadow:0 18px 40px rgba(15,23,42,.25)}.progress{color:var(--sub);font-size:12px;margin-top:8px;min-height:18px}#importJson,#importHtml{display:none}@media(max-width:900px){.filters{grid-template-columns:1fr 1fr}.data-grid,.form-grid{grid-template-columns:1fr}.nav-tabs{grid-template-columns:1fr}.row{grid-template-columns:1fr}.row .select-cell{display:none}.batch{grid-template-columns:1fr}.batch select{width:100%}.top{align-items:flex-start;flex-direction:column}}@media(max-width:560px){.wrap{width:min(100% - 20px,1180px);padding-top:16px}.hero{padding:18px}.hero h1{font-size:26px}.top-actions,.form-actions,.data-actions{width:100%}.btn{flex:1}.filters{grid-template-columns:1fr}.links{grid-template-columns:1fr}.section{padding:14px}.card{min-height:auto}.card-actions{position:static;opacity:1;margin-top:10px}.card-main{width:100%}.card{display:block}.fav{margin-bottom:8px}}

/* Button size refinement: keep import/export actions compact */
label.btn{display:inline-flex;margin:0;color:var(--text);font-weight:650}
.data-actions{align-items:center;gap:8px}
.data-card .btn{padding:7px 11px;min-height:34px;font-size:12.5px;line-height:1.2;border-radius:7px;box-shadow:0 1px 4px rgba(15,23,42,.035)}
.data-card .data-actions .btn{flex:0 0 auto;white-space:nowrap}
.data-card h3{line-height:1.25}
.data-card p{line-height:1.45;margin-bottom:11px}
@media(max-width:560px){.data-actions .btn,.data-card .btn{flex:0 0 auto}.data-actions{width:auto}}


/* Minimal fixes for list/card overlap in the uploaded base file */
@media(min-width:901px){
  /* Keep the selector column reserved in detailed list view.
     Otherwise the hidden checkbox cell is removed and the title falls into the 24px column, causing URL overlap. */
  .row .select-cell.hidden{display:block!important;visibility:hidden;pointer-events:none}
}
.row b,.row a,.row .muted{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.row-actions{display:flex;gap:6px;justify-content:flex-end;align-items:center;white-space:nowrap}

/* Reserve space for card action buttons and hide them fully until hover, avoiding ghost/overlap. */
.card{padding-bottom:52px}
.card .chips{padding-right:4px}
.card-actions{opacity:0;pointer-events:none;bottom:12px;background:linear-gradient(90deg,rgba(255,255,255,0),#fff 20%);padding-left:16px}
.card:hover .card-actions{opacity:1;pointer-events:auto}
@media(max-width:560px){
  .card{padding-bottom:14px}
  .card-actions{background:transparent;padding-left:0;pointer-events:auto}
}



/* Bulk add panel */
.bulk-help{margin:0 0 12px;color:var(--sub);font-size:12.5px;line-height:1.55}
#bulkText{min-height:150px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12.5px;line-height:1.55}
.bulk-options{display:flex;align-items:center;gap:12px;flex-wrap:wrap;color:var(--sub);font-size:12px}
.checkline{display:inline-flex;align-items:center;gap:6px;margin:0;color:var(--sub);font-size:12.5px;font-weight:600}
.checkline input{width:auto;margin:0}
.bulk-example{color:var(--muted);font-size:12px}
:root[data-theme="dark"] .bulk-help,
:root[data-theme="dark"] .bulk-options,
:root[data-theme="dark"] .checkline{color:var(--sub)}

/* Created / updated time display */
.time-meta{display:flex;flex-wrap:wrap;gap:5px 10px;margin-top:7px;color:var(--muted);font-size:11px;line-height:1.35}
.time-meta span{white-space:nowrap}
.row{grid-template-columns:24px minmax(0,1.45fr) .75fr .7fr auto}
.row-main{min-width:0;display:grid;gap:3px}
.row-main b,.row-main a{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.row-main a{font-size:12px;color:var(--blue);text-decoration:none}
.row-time{margin-top:2px}
.manage-list .row{grid-template-columns:24px minmax(0,1.45fr) .75fr .7fr auto}
@media(max-width:900px){.row,.manage-list .row{grid-template-columns:1fr}.row-main a{white-space:normal;overflow:visible;text-overflow:clip}.row-time span{white-space:normal}}
:root[data-theme="dark"] .time-meta{color:var(--muted)}


/* Eye-care dark theme */
:root[data-theme="dark"]{color-scheme:dark;--bg:#111827;--panel:#172033;--soft:#1f2937;--line:#2b3648;--line2:#3a4659;--text:#e5e7eb;--sub:#a7b0c0;--muted:#7c8798;--blue:#60a5fa;--blue2:#3b82f6;--green:#34d399;--greenBg:rgba(16,185,129,.15);--amber:#fbbf24;--amberBg:rgba(245,158,11,.16);--red:#f87171;--redBg:rgba(239,68,68,.15);--grayBg:#263244;--shadow:0 16px 36px rgba(0,0,0,.28)}
:root[data-theme="dark"] body{background:radial-gradient(circle at 10% 0,rgba(96,165,250,.12),transparent 390px),var(--bg)}
:root[data-theme="dark"] .hero,
:root[data-theme="dark"] .panel,
:root[data-theme="dark"] .section,
:root[data-theme="dark"] .nav-tab,
:root[data-theme="dark"] .stat,
:root[data-theme="dark"] .row,
:root[data-theme="dark"] .data-card,
:root[data-theme="dark"] .form-card,
:root[data-theme="dark"] .empty{background:rgba(23,32,51,.92);border-color:var(--line)}
:root[data-theme="dark"] .card{background:linear-gradient(#1b2537,#172033);border-color:var(--line);box-shadow:none}
:root[data-theme="dark"] .card:hover{border-color:#4b5f7a;box-shadow:0 10px 24px rgba(0,0,0,.18)}
:root[data-theme="dark"] .nav-tab.active{background:rgba(37,99,235,.18);border-color:rgba(96,165,250,.42)}
:root[data-theme="dark"] input,
:root[data-theme="dark"] select,
:root[data-theme="dark"] textarea{background:#111827;border-color:var(--line2);color:var(--text)}
:root[data-theme="dark"] input::placeholder,
:root[data-theme="dark"] textarea::placeholder{color:#788397}
:root[data-theme="dark"] .btn{background:#1f2937;border-color:var(--line2);color:var(--text);box-shadow:none}
:root[data-theme="dark"] .btn:hover:not(:disabled){border-color:#52627a}
:root[data-theme="dark"] .btn.primary{background:var(--blue2);border-color:var(--blue2);color:#fff}
:root[data-theme="dark"] .btn.ghost{background:transparent}
:root[data-theme="dark"] .view-switch .btn.active{background:#e5e7eb;color:#111827;border-color:#e5e7eb}
:root[data-theme="dark"] .fav{background:#21304a;color:var(--blue)}
:root[data-theme="dark"] .card-title a,
:root[data-theme="dark"] .empty b{color:var(--text)}
:root[data-theme="dark"] .desc,
:root[data-theme="dark"] label,
:root[data-theme="dark"] select{color:var(--sub)}
:root[data-theme="dark"] .section-head{border-bottom-color:#273244}
:root[data-theme="dark"] .suggest{background:#172033;border-color:var(--line2);box-shadow:0 16px 34px rgba(0,0,0,.35)}
:root[data-theme="dark"] .suggest button{color:var(--text)}
:root[data-theme="dark"] .suggest button:hover{background:#21304a;color:var(--blue)}
:root[data-theme="dark"] .card-actions{background:linear-gradient(90deg,rgba(23,32,51,0),#172033 20%)}
@media(max-width:560px){:root[data-theme="dark"] .card-actions{background:transparent}}

/* Batch management panel */
.batch-manage-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;align-items:end}
.batch-manage-actions{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:12px}
.batch-manage-note{color:var(--sub);font-size:12px;margin:0 0 12px}
.checkline-inline{display:flex;align-items:center;gap:8px;color:var(--sub);font-size:12px;font-weight:650}
.checkline-inline input{width:auto}
.manage-list .select-cell input{width:auto}
@media(max-width:900px){.batch-manage-grid{grid-template-columns:1fr}}

</style>
</head>
<body>
<div class="wrap">
  <header class="top">
    <div class="brand"><i>★</i><span>本地书签目录</span></div>
    <div class="top-actions"><button class="btn" id="themeToggle" type="button">暗色护眼</button><button class="btn" id="addQuick">添加书签</button><button class="btn primary" data-page="data">导入 / 导出</button><button class="btn" id="checkAll">检测全部</button></div>
  </header>
  <section class="hero"><h1>我的网址导航</h1><p>单 HTML 本地保存。日常用导航展示，批量维护到管理页，备份迁移到导入 / 导出。</p></section>
  <nav class="nav-tabs"><button class="nav-tab active" data-page="home"><b>导航展示</b><span>卡片或列表浏览</span></button><button class="nav-tab" data-page="manage"><b>书签管理</b><span>添加、编辑、检测</span></button><button class="nav-tab" data-page="data"><b>导入 / 导出</b><span>备份、迁移、清空</span></button></nav>
  <div class="stats" id="stats"></div>

  <main id="homePage">
    <section class="panel toolbar">
      <div class="search"><span>⌕</span><input id="q" type="search" placeholder="搜索标题、网址、分类、标签或备注"></div>
      <div class="filters"><select id="catFilter"></select><select id="domainFilter"></select><select id="tagFilter"></select><select id="statusFilter"><option value="all">全部状态</option><option value="unchecked">未检测</option><option value="alive">可访问</option><option value="warning">需关注</option></select><input id="urlFilter" placeholder="URL 包含"><select id="sort"><option value="category">按分类 A-Z</option><option value="domain">按域名 A-Z</option><option value="url">按 URL A-Z</option><option value="title">按标题 A-Z</option><option value="updated">最近更新</option><option value="added">最近添加</option><option value="status">按状态</option></select></div>
      <div class="filter-mini"><span id="resultInfo">0 个结果</span><div class="view-switch"><button class="btn sm active" id="cardView">导航卡片</button><button class="btn sm" id="listView">详细列表</button></div></div>
    </section>
    <section class="panel batch">
      <div class="batch-left"><span class="batch-note">批量操作</span><select id="checkCat"></select><button class="btn sm" id="checkCatBtn">检测分类</button><button class="btn sm" id="openCatBtn">打开分类</button><button class="btn sm" id="openCurrentBtn">打开当前结果</button><button class="btn sm" id="selectModeBtn">多选</button><button class="btn sm hidden" id="selectCurrentBtn">全选当前</button><button class="btn sm primary hidden" id="checkSelectedBtn">检测已选</button><button class="btn sm primary hidden" id="openSelectedBtn">打开已选</button><button class="btn sm hidden" id="cancelSelectBtn">取消选择</button></div>
      <div class="progress" id="progress"></div>
    </section>
    <div class="grid" id="cards"></div>
    <div class="list hidden" id="list"></div>
    <div class="empty hidden" id="empty"><b>暂无书签</b>先添加或导入浏览器书签。</div>
  </main>

  <main id="managePage" class="hidden">
    <section class="panel form-card">
      <h2 id="formTitle" style="font-size:18px;margin:0 0 14px">添加书签</h2>
      <form id="form" autocomplete="off"><input type="hidden" id="bid"><div class="form-grid">
        <label><span>标题</span><input id="title" required placeholder="例如：GitHub"></label>
        <label><span>URL</span><input id="url" required placeholder="https://example.com"></label>
        <label class="suggest-wrap"><span>分类</span><input id="category" placeholder="选择已有分类或输入新的"><div class="suggest hidden" id="catSuggest"></div></label>
        <label class="suggest-wrap"><span>标签</span><input id="tags" placeholder="用逗号分隔，可选择已有标签"><div class="suggest hidden" id="tagSuggest"></div></label>
        <label class="wide"><span>备注</span><textarea id="note" placeholder="用途、账号、入口说明等"></textarea></label>
      </div><div class="form-actions"><button class="btn primary" type="submit">保存</button><button class="btn" id="resetForm" type="button">清空</button></div></form>
    </section>
    <section class="panel form-card" style="margin-top:16px">
      <h2 style="font-size:18px;margin:0 0 8px">批量添加</h2>
      <p class="bulk-help">每行一个书签。只粘贴 URL 时会尽量读取页面标题；读不到时使用域名。支持 <b>标题 | URL | 分类 | 标签 | 备注</b>。</p>
      <div class="form-grid">
        <label class="wide"><span>链接列表</span><textarea id="bulkText" placeholder="例如：
GitHub | https://github.com | 开发资源 | 代码, 开发 | 代码托管平台
https://www.notion.so
ChatGPT https://chat.openai.com"></textarea></label>
        <label class="suggest-wrap"><span>默认分类</span><input id="bulkCategory" placeholder="没有填写分类时使用"><div class="suggest hidden" id="bulkCatSuggest"></div></label>
        <label class="suggest-wrap"><span>默认标签</span><input id="bulkTags" placeholder="没有填写标签时使用，可用逗号分隔"><div class="suggest hidden" id="bulkTagSuggest"></div></label>
        <div class="wide bulk-options"><label class="checkline"><input id="skipDuplicates" type="checkbox" checked>跳过重复 URL</label><span class="bulk-example">重复判断会忽略 URL 末尾的 /。</span></div>
      </div>
      <div class="form-actions"><button class="btn primary" id="bulkAddBtn" type="button">批量添加</button><button class="btn" id="clearBulkBtn" type="button">清空批量内容</button></div>
    </section>
    <section class="panel form-card" style="margin-top:16px">
      <h2 style="font-size:18px;margin:0 0 8px">批量管理</h2>
      <p class="batch-manage-note">可对已勾选、指定分类、当前筛选结果或全部书签批量修改。</p>
