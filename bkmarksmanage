<script>
(()=>{const KEY='local-bookmarks-v1',THEME_KEY='local-bookmarks-theme';let bookmarks=[],page='home',view='card',selectMode=false,selected=new Set();
function applyTheme(mode){document.documentElement.dataset.theme=mode;try{localStorage.setItem(THEME_KEY,mode)}catch(e){}const b=document.getElementById('themeToggle');if(b)b.textContent=mode==='dark'?'浅色模式':'暗色护眼'}
applyTheme(document.documentElement.dataset.theme||'light');
const $=id=>document.getElementById(id);const els={stats:$('stats'),home:$('homePage'),manage:$('managePage'),data:$('dataPage'),cards:$('cards'),list:$('list'),empty:$('empty'),q:$('q'),catFilter:$('catFilter'),domainFilter:$('domainFilter'),tagFilter:$('tagFilter'),statusFilter:$('statusFilter'),urlFilter:$('urlFilter'),sort:$('sort'),resultInfo:$('resultInfo'),progress:$('progress'),checkCat:$('checkCat'),toast:$('toast')};
const now=()=>new Date().toISOString();const esc=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));const uid=()=>crypto.randomUUID?crypto.randomUUID():Date.now()+Math.random().toString(16).slice(2);const host=u=>{try{return new URL(normalize(u)).hostname.replace(/^www\./,'')}catch{return''}};const normalize=u=>/^https?:\/\//i.test(String(u).trim())?String(u).trim():'https://'+String(u).trim();const tags=s=>String(s||'').split(/[,，]/).map(x=>x.trim()).filter(Boolean);const statusGroup=s=>!s||s==='unchecked'?'unchecked':['alive','redirect','restricted'].includes(s)?'alive':['broken','invalid'].includes(s)?'broken':'warning';const statusText=s=>({unchecked:'未检测',checking:'检测中',alive:'可访问',redirect:'可访问',restricted:'疑似可访问',warning:'需关注',timeout:'需关注',broken:'失效',invalid:'格式错误'}[s]||'未检测');const fmtTime=ts=>{if(!ts)return'无记录';const d=new Date(ts);if(Number.isNaN(d.getTime()))return'无记录';return d.toLocaleString('zh-CN',{year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',hour12:false}).replace(/\//g,'-')};const timeMeta=b=>`<div class="time-meta"><span>添加：${esc(fmtTime(b.createdAt))}</span><span>修改：${esc(fmtTime(b.updatedAt||b.createdAt))}</span></div>`;
function save(){localStorage.setItem(KEY,JSON.stringify(bookmarks))}function load(){try{bookmarks=JSON.parse(localStorage.getItem(KEY)||'[]')}catch{bookmarks=[]}if(!bookmarks.length){try{const em=JSON.parse($('embeddedData').textContent||'[]');if(em.length){bookmarks=em;save()}}catch{}}let changed=false;bookmarks=bookmarks.map(b=>{if(!b.createdAt){b.createdAt=b.updatedAt||now();changed=true}if(!b.updatedAt){b.updatedAt=b.createdAt;changed=true}return b});if(changed)save()}
function seed(){if(bookmarks.length)return;bookmarks=[{id:uid(),title:'GitHub',url:'https://github.com',category:'开发资源',tags:['代码','开发'],note:'代码托管平台',status:'unchecked',createdAt:now(),updatedAt:now()},{id:uid(),title:'ChatGPT',url:'https://chat.openai.com',category:'AI工具',tags:['AI'],note:'智能对话助手',status:'unchecked',createdAt:now(),updatedAt:now()},{id:uid(),title:'Notion',url:'https://www.notion.so',category:'效率工具',tags:['文档','笔记'],note:'笔记与知识管理',status:'unchecked',createdAt:now(),updatedAt:now()}];save()}
const cats=()=>[...new Set(bookmarks.map(b=>b.category||'未分类'))].sort((a,b)=>a.localeCompare(b,'zh-Hans-CN'));const domains=()=>[...new Set(bookmarks.map(b=>host(b.url)).filter(Boolean))].sort();const allTags=()=>[...new Set(bookmarks.flatMap(b=>b.tags||[]))].sort((a,b)=>a.localeCompare(b,'zh-Hans-CN'));
function fillSelect(sel,items,allText){if(!sel)return;const old=sel.value;sel.innerHTML='<option value="all">'+allText+'</option>'+items.map(x=>`<option value="${esc(x)}">${esc(x)}</option>`).join('');if([...sel.options].some(o=>o.value===old))sel.value=old}function refreshFilters(){fillSelect(els.catFilter,cats(),'全部分类');fillSelect(els.domainFilter,domains(),'全部域名');fillSelect(els.tagFilter,allTags(),'全部标签');fillSelect(els.checkCat,cats(),'选择分类');fillSelect($('batchManageCat'),cats(),'选择分类')}
function filtered(){let arr=[...bookmarks],q=els.q.value.trim().toLowerCase(),cf=els.catFilter.value,df=els.domainFilter.value,tf=els.tagFilter.value,sf=els.statusFilter.value,uf=els.urlFilter.value.trim().toLowerCase();if(q)arr=arr.filter(b=>[b.title,b.url,b.category,b.note,(b.tags||[]).join(',')].join(' ').toLowerCase().includes(q));if(cf!=='all')arr=arr.filter(b=>(b.category||'未分类')===cf);if(df!=='all')arr=arr.filter(b=>host(b.url)===df);if(tf!=='all')arr=arr.filter(b=>(b.tags||[]).includes(tf));if(sf!=='all')arr=arr.filter(b=>statusGroup(b.status)===sf);if(uf)arr=arr.filter(b=>String(b.url).toLowerCase().includes(uf));const s=els.sort.value;arr.sort((a,b)=>{if(s==='domain')return host(a.url).localeCompare(host(b.url));if(s==='url')return a.url.localeCompare(b.url);if(s==='title')return a.title.localeCompare(b.title,'zh-Hans-CN');if(s==='updated')return String(b.updatedAt).localeCompare(String(a.updatedAt));if(s==='added')return String(b.createdAt).localeCompare(String(a.createdAt));if(s==='status')return statusGroup(a.status).localeCompare(statusGroup(b.status));return (a.category||'未分类').localeCompare(b.category||'未分类','zh-Hans-CN')||a.title.localeCompare(b.title,'zh-Hans-CN')});return arr}
function renderStats(){const alive=bookmarks.filter(b=>statusGroup(b.status)==='alive').length,warn=bookmarks.filter(b=>statusGroup(b.status)==='warning').length;els.stats.innerHTML=`<span class="stat"><b>${bookmarks.length}</b>书签</span><span class="stat"><b>${cats().length}</b>分类</span><span class="stat"><b>${alive}</b>可访问</span><span class="stat"><b>${warn}</b>需关注</span>`}
function card(b){const d=host(b.url),sg=statusGroup(b.status);return `<article class="card"><label class="select-mark ${selectMode?'':'hidden'}"><input type="checkbox" data-select="${b.id}" ${selected.has(b.id)?'checked':''}></label><div class="fav"><img src="https://www.google.com/s2/favicons?sz=64&domain_url=${encodeURIComponent(b.url)}" onerror="this.remove()"><span>${esc((b.title||'?')[0])}</span></div><div class="card-main"><h3 class="card-title"><a href="${esc(normalize(b.url))}" target="_blank">${esc(b.title)}</a><span class="status s-${sg}">${statusText(b.status)}</span></h3><p class="desc">${esc(b.note||'')}</p><a class="domain" href="${esc(normalize(b.url))}" target="_blank">${esc(d||b.url)}</a><div class="chips"><span class="chip">${esc(b.category||'未分类')}</span>${(b.tags||[]).slice(0,3).map(t=>`<span class="chip">${esc(t)}</span>`).join('')}</div><div class="card-actions"><button class="btn sm" data-check="${b.id}">检测</button><button class="btn sm" data-edit="${b.id}">编辑</button><button class="btn sm" data-copy="${b.id}">复制</button></div></div></article>`}
function renderHome(){const arr=filtered();els.resultInfo.textContent=`${arr.length} 个结果`;els.empty.classList.toggle('hidden',arr.length>0);els.cards.classList.toggle('hidden',view!=='card'||!arr.length);els.list.classList.toggle('hidden',view!=='list'||!arr.length);if(view==='card'){const groups={};arr.forEach(b=>{const c=b.category||'未分类';(groups[c]||(groups[c]=[])).push(b)});els.cards.innerHTML=Object.entries(groups).map(([c,bs])=>`<section class="section"><div class="section-head"><h2>${esc(c)}</h2><small>${bs.length} 个网站</small></div><div class="links">${bs.map(card).join('')}</div></section>`).join('')}else{els.list.innerHTML=arr.map(b=>`<div class="row"><span class="select-cell ${selectMode?'':'hidden'}"><input type="checkbox" data-select="${b.id}" ${selected.has(b.id)?'checked':''}></span><div class="row-main"><b>${esc(b.title)}</b><a href="${esc(normalize(b.url))}" target="_blank">${esc(b.url)}</a>${timeMeta(b)}</div><span class="muted">${esc(b.category||'未分类')}</span><span class="status s-${statusGroup(b.status)}">${statusText(b.status)}</span><span class="row-actions"><button class="btn sm" data-check="${b.id}">检测</button><button class="btn sm" data-edit="${b.id}">编辑</button></span></div>`).join('')}}
function renderManage(){const box=$('manageList');box.innerHTML=bookmarks.map(b=>`<div class="row"><span class="select-cell"><input type="checkbox" data-select="${b.id}" ${selected.has(b.id)?'checked':''}></span><div class="row-main"><b>${esc(b.title)}</b><a href="${esc(normalize(b.url))}" target="_blank">${esc(b.url)}</a>${timeMeta(b)}</div><span class="muted">${esc(b.category||'未分类')}</span><span class="status s-${statusGroup(b.status)}">${statusText(b.status)}</span><span class="row-actions"><button class="btn sm" data-edit="${b.id}">编辑</button><button class="btn sm" data-check="${b.id}">检测</button><button class="btn sm danger" data-del="${b.id}">删除</button></span></div>`).join('')||'<div class="empty"><b>暂无书签</b>先添加或导入。</div>'}
function render(){refreshFilters();renderStats();renderHome();renderManage();document.querySelectorAll('.nav-tab').forEach(b=>b.classList.toggle('active',b.dataset.page===page));els.home.classList.toggle('hidden',page!=='home');els.manage.classList.toggle('hidden',page!=='manage');els.data.classList.toggle('hidden',page!=='data');$('cardView').classList.toggle('active',view==='card');$('listView').classList.toggle('active',view==='list');['selectCurrentBtn','checkSelectedBtn','openSelectedBtn','cancelSelectBtn'].forEach(id=>$(id).classList.toggle('hidden',!selectMode))}
function toast(t){els.toast.textContent=t;els.toast.classList.remove('hidden');clearTimeout(toast.t);toast.t=setTimeout(()=>els.toast.classList.add('hidden'),2200)}
function edit(id){const b=bookmarks.find(x=>x.id===id);if(!b)return;page='manage';$('formTitle').textContent='编辑书签';$('bid').value=b.id;$('title').value=b.title;$('url').value=b.url;$('category').value=b.category||'';$('tags').value=(b.tags||[]).join(', ');$('note').value=b.note||'';render();scrollTo({top:0,behavior:'smooth'})}
async function checkOne(id){const b=bookmarks.find(x=>x.id===id);if(!b)return;b.status='checking';render();let st='warning';try{const c=new AbortController();const timer=setTimeout(()=>c.abort(),8000);const r=await fetch(normalize(b.url),{method:'HEAD',mode:'no-cors',signal:c.signal});clearTimeout(timer);st=r.type==='opaque'?'restricted':(r.ok?'alive':(r.status>=300&&r.status<400?'redirect':(r.status>=400?'broken':'warning')))}catch(e){st=e.name==='AbortError'?'timeout':'warning'}b.status=st;b.checkedAt=now();b.updatedAt=now();save();render()}
async function checkMany(arr){for(let i=0;i<arr.length;i++){els.progress.textContent=`检测中 ${i+1}/${arr.length}`;await checkOne(arr[i].id)}els.progress.textContent='检测完成';toast('检测完成')}
function openMany(arr){const list=arr.filter(b=>b&&b.url);if(!list.length)return toast('没有可打开的链接');if(list.length>12&&!confirm(`即将打开 ${list.length} 个链接，浏览器可能会拦截弹窗。是否继续？`))return;let opened=0;for(const b of list){const w=window.open(normalize(b.url),'_blank','noopener');if(w)opened++}toast(opened===list.length?`已尝试打开 ${list.length} 个链接`:`已打开 ${opened}/${list.length} 个链接，未打开的可能被浏览器拦截`)}
function resetForm(){$('form').reset();$('bid').value='';$('formTitle').textContent='添加书签'}
function download(name,text,type='application/octet-stream'){const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([text],{type}));a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),500)}
function exportBrowser(){const groups={};bookmarks.forEach(b=>{(groups[b.category||'未分类']||(groups[b.category||'未分类']=[])).push(b)});let h='<!DOCTYPE NETSCAPE-Bookmark-file-1><META HTTP-EQUIV="Content-Type" CONTENT="text/html; charset=UTF-8"><TITLE>Bookmarks</TITLE><H1>Bookmarks</H1><DL><p>';for(const [c,bs] of Object.entries(groups)){h+=`<DT><H3>${esc(c)}</H3><DL><p>`+bs.map(b=>`<DT><A HREF="${esc(normalize(b.url))}" ADD_DATE="${Math.floor(new Date(b.createdAt||now()).getTime()/1000)}">${esc(b.title)}</A>`).join('')+'</DL><p>'}h+='</DL><p>';download('bookmarks.html',h,'text/html')}
function parseBrowser(html){const doc=new DOMParser().parseFromString(html,'text/html'),out=[];function walk(dl,cat){[...dl.children].forEach(el=>{if(el.tagName==='DT'){const h3=el.querySelector(':scope>h3'),a=el.querySelector(':scope>a'),sub=el.querySelector(':scope>dl');if(a)out.push({id:uid(),title:a.textContent.trim()||a.href,url:a.href,category:cat||'未分类',tags:[],note:'',status:'unchecked',createdAt:now(),updatedAt:now()});if(h3&&sub)walk(sub,h3.textContent.trim())}})}walk(doc.querySelector('dl')||doc.body,'');return out}
function urlKey(u){try{return normalize(u).replace(/\/+$/,'').toLowerCase()}catch{return String(u||'').trim().replace(/\/+$/,'').toLowerCase()}}
function findUrlPart(text){const m=String(text||'').match(/https?:\/\/[^\s|，,]+|www\.[^\s|，,]+|[a-z0-9-]+(?:\.[a-z0-9-]+)+(?:\/[^\s|，,]*)?/i);return m?m[0]:''}
function titleFromUrl(u){const h=host(u);return h?h.split('.')[0].replace(/^./,c=>c.toUpperCase()):u}
async function fetchPageTitle(u){try{const c=new AbortController();const timer=setTimeout(()=>c.abort(),6500);const r=await fetch(normalize(u),{method:'GET',mode:'cors',signal:c.signal});clearTimeout(timer);if(!r.ok)return '';const html=await r.text();const m=html.match(/<title[^>]*>([\s\S]*?)<\/title>/i);if(!m)return '';const box=document.createElement('textarea');box.innerHTML=m[1].replace(/\s+/g,' ').trim();return box.value.trim()}catch{return ''}}
function parseBulkLine(line,defCat,defTags){line=String(line||'').trim();if(!line)return null;let title='',url='',category='',tagText='',note='',autoTitle=false;const hasSep=/[|\t]/.test(line);if(hasSep){const parts=line.split(/\s*\|\s*|\t+/).map(x=>x.trim()).filter(Boolean);const ui=parts.findIndex(p=>findUrlPart(p));if(ui<0)return null;url=findUrlPart(parts[ui]);if(ui===0){title=parts[1]||'';autoTitle=!title;category=parts[2]||defCat;tagText=parts[3]||defTags;note=parts.slice(4).join(' | ')}else{title=parts[0]||'';autoTitle=!title;category=parts[ui+1]||defCat;tagText=parts[ui+2]||defTags;note=parts.slice(ui+3).join(' | ')}}else{url=findUrlPart(line);if(!url)return null;const before=line.slice(0,line.indexOf(url)).trim();const after=line.slice(line.indexOf(url)+url.length).trim();title=before;autoTitle=!before;category=defCat;tagText=defTags;note=after}
return {id:uid(),title:title.trim()||titleFromUrl(url),url:normalize(url),category:(category||defCat||'未分类').trim(),tags:tags(tagText||defTags),note:(note||'').trim(),status:'unchecked',createdAt:now(),updatedAt:now(),autoTitle}}
async function bulkAdd(){const text=$('bulkText').value;const lines=text.split(/\r?\n/).map(x=>x.trim()).filter(Boolean);if(!lines.length)return toast('请先粘贴链接');const defCat=$('bulkCategory').value.trim();const defTags=$('bulkTags').value.trim();const skip=$('skipDuplicates').checked;const seen=new Set(bookmarks.map(b=>urlKey(b.url)));const added=[];let invalid=0,dup=0,titleOk=0;for(const line of lines){const item=parseBulkLine(line,defCat,defTags);if(!item){invalid++;continue}const key=urlKey(item.url);if(skip&&seen.has(key)){dup++;continue}seen.add(key);added.push(item)}for(let i=0;i<added.length;i++){if(!added[i].autoTitle)continue;els.progress.textContent=`读取页面标题 ${i+1}/${added.length}`;const t=await fetchPageTitle(added[i].url);if(t){added[i].title=t;titleOk++}delete added[i].autoTitle}if(added.length){bookmarks=[...added,...bookmarks];save()}els.progress.textContent='';render();toast(`已添加 ${added.length} 个${titleOk?`，自动读取标题 ${titleOk} 个`:''}${dup?`，跳过重复 ${dup} 个`:''}${invalid?`，无效 ${invalid} 行`:''}`)}

function dedupeKey(u){try{const x=new URL(normalize(u));x.hash='';let p=x.pathname.replace(/\/+$/,'');if(!p)p='';return x.hostname.replace(/^www\./,'').toLowerCase()+p.toLowerCase()+x.search.toLowerCase()}catch{return String(u||'').trim().toLowerCase().replace(/^https?:\/\//,'').replace(/^www\./,'').replace(/\/+$/,'')}}
function findDuplicates(){const seen=new Map(),dups=[];for(const b of bookmarks){const k=dedupeKey(b.url);if(!k)continue;if(seen.has(k))dups.push({keep:seen.get(k),drop:b,key:k});else seen.set(k,b)}return dups}
function previewDedupe(){const dups=findDuplicates();if(!dups.length)return toast('没有发现重复书签');const groups=new Map();dups.forEach(x=>{if(!groups.has(x.key))groups.set(x.key,[]);groups.get(x.key).push(x.drop)});toast(`发现 ${dups.length} 条重复书签，涉及 ${groups.size} 个 URL`)}
function mergeBookmarkData(keep,drop){const kt=new Set(keep.tags||[]);(drop.tags||[]).forEach(t=>kt.add(t));keep.tags=[...kt];if((!keep.note||!keep.note.trim())&&drop.note)keep.note=drop.note;if((!keep.category||keep.category==='未分类')&&drop.category)keep.category=drop.category;if((!keep.status||keep.status==='unchecked')&&drop.status)keep.status=drop.status;if(drop.checkedAt&&(!keep.checkedAt||String(drop.checkedAt)>String(keep.checkedAt)))keep.checkedAt=drop.checkedAt;if(drop.createdAt&&(!keep.createdAt||String(drop.createdAt)<String(keep.createdAt)))keep.createdAt=drop.createdAt;if(drop.updatedAt&&(!keep.updatedAt||String(drop.updatedAt)>String(keep.updatedAt)))keep.updatedAt=drop.updatedAt;else keep.updatedAt=now()}
function dedupeBookmarks(){const dups=findDuplicates();if(!dups.length)return toast('没有发现重复书签');if(!confirm(`发现 ${dups.length} 条重复书签。将保留当前列表中靠前的一条，并合并标签、备注、时间等信息，确定去重？`))return;const remove=new Set();for(const x of dups){mergeBookmarkData(x.keep,x.drop);remove.add(x.drop.id);selected.delete(x.drop.id)}bookmarks=bookmarks.filter(b=>!remove.has(b.id));save();render();toast(`已去重，删除 ${remove.size} 条重复书签`)}
function batchTargets(){const scope=$('batchManageScope')?.value||'selected';let arr=[];if(scope==='selected')arr=bookmarks.filter(b=>selected.has(b.id));else if(scope==='category'){const c=$('batchManageCat')?.value;if(!c||c==='all')return [];arr=bookmarks.filter(b=>(b.category||'未分类')===c)}else if(scope==='current')arr=filtered();else arr=[...bookmarks];return arr}
