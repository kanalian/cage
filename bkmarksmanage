function deleteBatchManage(){const arr=batchTargets();if(!arr.length)return toast('没有匹配的书签');if(!confirm(`确定删除 ${arr.length} 个书签？`))return;const ids=new Set(arr.map(b=>b.id));bookmarks=bookmarks.filter(b=>!ids.has(b.id));ids.forEach(id=>selected.delete(id));save();render();toast(`已删除 ${ids.size} 个书签`)}
function setupSuggest(input,panel,getItems,multi){function show(){const val=input.value.split(/[,，]/).pop().trim().toLowerCase();const chosen=multi?tags(input.value):[];const items=getItems().filter(x=>(!val||x.toLowerCase().includes(val))&&!chosen.includes(x)).slice(0,12);panel.innerHTML=items.map(x=>`<button type="button" data-v="${esc(x)}">${esc(x)}</button>`).join('')||'<button type="button" disabled>没有匹配项</button>';panel.classList.remove('hidden')}input.addEventListener('focus',show);input.addEventListener('input',show);panel.addEventListener('mousedown',e=>{const b=e.target.closest('button[data-v]');if(!b)return;e.preventDefault();if(multi){let parts=tags(input.value);parts.push(b.dataset.v);input.value=[...new Set(parts)].join(', ')}else input.value=b.dataset.v;panel.classList.add('hidden')});document.addEventListener('click',e=>{if(!panel.parentElement.contains(e.target))panel.classList.add('hidden')})}
